# Copy to .env and replace the placeholders. Never commit .env.
MONGODB_URI=mongodb://127.0.0.1:27017/gymtracker
JWT_SECRET=replace-with-a-long-random-secret
PORT=4000
APP_URL=http://localhost:5173
NODE_ENV=development

# Optional in development; required for production account emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
