{
  "name": "gym-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": "^22.13.0 || >=24.0.0" },
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --host",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "preview:ui": "node scripts/preview-ui.mjs",
    "test:progress": "node --test scripts/progress.test.mjs",
    "test:unit": "node --test scripts/progress.test.mjs scripts/session-edit.test.mjs scripts/offline-shell.test.mjs",
    "test:integration": "node --test scripts/reliability.test.mjs scripts/admin.test.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "test:ui": "vitest run",
    "test": "npm run test:unit && npm run test:integration && npm run test:ui"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.1",
    "nodemailer": "^10.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.4",
    "jsdom": "^29.1.1",
    "mongodb-memory-server": "^11.3.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
